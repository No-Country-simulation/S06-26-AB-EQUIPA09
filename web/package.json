        "@tanstack/react-table": "^8.21.3",
        "axios": "^1.10.0",
        "framer-motion": "^12.23.0",
        "leaflet": "^1.9.4",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-icons": "^5.7.0",
        "react-leaflet": "^5.0.0",
        "react-redux": "^9.3.0",
